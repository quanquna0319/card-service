# 复制为 .env 后填写。不要提交 .env。
CARD_SECRET=replace-with-a-random-64-char-secret
CARD_APP_ID=APP_ID
CARD_ADMIN_USER=admin
CARD_ADMIN_PASSWORD=replace-with-a-strong-password
TZ=Asia/Shanghai

# 可选：Docker 镜像没有 .git 时，维护页直接从 GitHub 下载源码包更新。
# 默认仓库与分支已写入镜像，只有 fork 时才需要改。
# CARD_UPDATE_MODE=auto
# CARD_UPDATE_REPO=quanquna0319/card-service
# CARD_UPDATE_BRANCH=main
# 留存下来的源码包目录，维护页可以下载或删除；留空时放在数据库同级目录。
# CARD_UPDATE_PACKAGE_DIR=/data/update-packages
# 私有仓库或 GitHub API 限流时填写只读令牌。
# GITHUB_TOKEN=

# 可选：配置后优先执行自定义更新命令，而不是下载源码包。
# CARD_UPDATE_COMMAND=/opt/card-service/update.sh

# 可选：启用 caddy 自动 HTTPS 时填写
# CARD_DOMAIN=card.example.com
# ACME_EMAIL=ops@example.com
